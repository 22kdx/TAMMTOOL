كلا التطبيقين يصرّحان exportSchema=true (marketer بالافتراضي لعدم تذكرته، orders
صراحة في AppDatabase.kt سطر 22) مع غياب أي room.schemaLocation ومجلد app/schemas
غير موجود ⇒ Room يرفض البناء في kaptDebugKotlin بـ:
  error: Schema export directory was not provided to the annotation processor
الأقل كسراً: تصدير المخطط بدل إطفاء exportSchema (مفيد أيضاً لمراجعات migration).

مُتحقَّق: توازن الأقواس في الملفين، والكتلة في مستوى المشروع لا داخل android {}.
غير مُتحقَّق: لا Gradle في بيئة العمل ⇒ أول بناء حقيقي يؤكد.

Co-authored-by: arena-agent <297053741+arena-agent@users.noreply.github.com>
---
 apps/marketer/app/build.gradle.kts        | 8 ++++++++
 apps/orders-delivery/app/build.gradle.kts | 8 ++++++++
 2 files changed, 16 insertions(+)

diff --git a/apps/marketer/app/build.gradle.kts b/apps/marketer/app/build.gradle.kts
index e8de2e8..fccd640 100644
--- a/apps/marketer/app/build.gradle.kts
+++ b/apps/marketer/app/build.gradle.kts
@@ -59,6 +59,14 @@ android {
     }
 }
 
+// Room: تصدير مخطط قاعدة البيانات ضروري لأن exportSchema=true — بلا room.schemaLocation يفشل kapt
+kapt {
+    correctErrorTypes = true
+    arguments {
+        arg("room.schemaLocation", "$projectDir/schemas")
+    }
+}
+
 dependencies {
     // Hilt DI
     implementation("com.google.dagger:hilt-android:2.50")
diff --git a/apps/orders-delivery/app/build.gradle.kts b/apps/orders-delivery/app/build.gradle.kts
index 3c6f890..7432d7c 100644
--- a/apps/orders-delivery/app/build.gradle.kts
+++ b/apps/orders-delivery/app/build.gradle.kts
@@ -59,6 +59,14 @@ android {
     }
 }
 
+// Room: تصدير مخطط قاعدة البيانات ضروري لأن exportSchema=true — بلا room.schemaLocation يفشل kapt
+kapt {
+    correctErrorTypes = true
+    arguments {
+        arg("room.schemaLocation", "$projectDir/schemas")
+    }
+}
+
 dependencies {
     // Hilt DI
     implementation("com.google.dagger:hilt-android:2.50")
