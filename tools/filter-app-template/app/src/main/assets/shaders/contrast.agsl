// تباين حول 0.5 — range الشدة 0..2 في FilterRegistry
uniform shader content;
uniform float amount;

half4 main(float2 coord) {
    half4 src = content.eval(coord);
    half3 c = (src.rgb - 0.5) * mix(1.0, 2.0, clamp(amount, 0.0, 1.0)) + 0.5;
    return half4(clamp(c, half3(0.0), half3(1.0)), src.a);
}
